# Unity Gitignore - Aayam Project

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Crash Reports
sysinfo.txt
crashlytics-build.properties

# Autogenerated VS/Rider/IDE files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Compressed files (from asset pipeline)
*.7z
*.gz
*.rar
*.tar
*.zip

# Gradle (Android)
unity/AayamAR.gradle/
unity/*.gradle

# Backend
backend/__pycache__/
backend/.env
backend/venv/
backend/*.pyc

# Dashboard
dashboard/node_modules/
dashboard/.next/
dashboard/.env.local

# ML
ml/runs/
ml/weights/
ml/data/
ml/*.onnx
ml/*.pt
ml/*.tflite
ml/*.mlmodel

# General
*.log
.env
.env.*
!.env.example
