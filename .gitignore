# Unity Gitignore - Aayam Project

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Crash Reports
sysinfo.txt
crashlytics-build.properties

# Autogenerated VS/Rider/IDE files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Compressed files (from asset pipeline)
*.7z
*.gz
*.rar
*.tar
*.zip

# Gradle (Android)
unity/AayamAR.gradle/
unity/*.gradle

# Backend
backend/__pycache__/
backend/.env
backend/venv/
backend/*.pyc

# Locally-served product assets (3D models, images) - binary content, not source.
# Folder structure is preserved via .gitkeep; real assets live here but aren't committed.
backend/storage/**/*.glb
backend/storage/**/*.gltf
backend/storage/**/*.png
backend/storage/**/*.jpg
backend/storage/**/*.jpeg
backend/storage/**/*.webp
backend/storage/**/*.ktx2

# Phase 3 training data - raw photos/exports, not source. Structure preserved
# via .gitkeep; this is where real content lives before going to Roboflow.
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.zip
datasets

# Dashboard
dashboard/node_modules/
dashboard/.next/
dashboard/.env.local

# ML - training artifacts, not source. The real model Unity needs is
# committed separately at Assets/_Project/MLModels/ (not ignored).
ml/runs/
ml/weights/
ml/data/
ml/*.onnx
ml/*.pt
ml/*.tflite
ml/*.mlmodel
ml/*.txt
# Ultralytics writes to runs/ at the repo root by default regardless of the
# project= override - see docs/phases/phase-3-implementation-plan.md Step 2.
/runs/
yolov8n.pt

# General
*.log
.env
.env.*
!.env.example


backend/.venv/
